{
  "name": "instagram-follow-checker",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "npm run build && playwright test",
    "build": "vite build",
    "preview": "vite preview --host 0.0.0.0",
    "format": "prettier --write src tests extension scripts *.js *.json index.html README.md",
    "format:check": "prettier --check src tests extension scripts *.js *.json index.html README.md",
    "build:extension": "vite build --base ./ --outDir dist-extension && node scripts/package-extension.mjs",
    "test:extension": "npm run build:extension && playwright test --config playwright.extension.config.js"
  },
  "dependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@vitejs/plugin-react": "^6.1.2",
    "fflate": "^0.8.3",
    "prettier": "^3.9.10",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "engines": {
    "node": "^22.12.0 || >=24.0.0"
  }
}
